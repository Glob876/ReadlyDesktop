{
  "name": "readly-desktop",
  "productName": "Readly",
  "version": "0.1.0",
  "private": true,
  "description": "Приложение для заучивания стихотворений",
  "main": "dist-electron/electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run check && node scripts/cargo.mjs build --release --manifest-path native/Cargo.toml && vite build && tsc -p electron/tsconfig.json",
    "check": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "start": "electron .",
    "test": "node scripts/cargo.mjs test --manifest-path native/Cargo.toml && node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "pack": "npm run build && node scripts/pack.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "electron": "45.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
